# Required for AI analysis
OPENAI_API_KEY=

# Standard OpenAI analysis model (gpt-4o-mini shuts down January 14, 2027)
OPENAI_MODEL=gpt-6-luna

# OpenAI Agents SDK model (defaults to OPENAI_MODEL)
OPENAI_AGENT_MODEL=gpt-6-luna

# Reasoning effort for reasoning models: none, low, medium or high
OPENAI_REASONING_EFFORT=low
